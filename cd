import hashlib
import math


class BloomFilter:

    def __init__(self, expected_items, false_positive_rate):
        self.size = int(
            - (expected_items * math.log(false_positive_rate))
            / (math.log(2) ** 2)
        )

        self.hash_count = int(
            (self.size / expected_items) * math.log(2)
        )

        self.bit_array = [0] * self.size

    def get_hashes(self, item):
        hashes = []

        for i in range(self.hash_count):
            value = hashlib.sha256(
                (str(i) + item).encode()
            ).hexdigest()

            hashes.append(int(value, 16) % self.size)

        return hashes

    def add(self, item):
        for index in self.get_hashes(item):
            self.bit_array[index] = 1

    def check(self, item):
        for index in self.get_hashes(item):
            if self.bit_array[index] == 0:
                return False

        return True


# Create Bloom Filter
bloom = BloomFilter(100, 0.01)

# Known malicious URLs
malicious_urls = [
    "http://fakebank-login.com",
    "http://free-prize-win.com",
    "http://malware-download.com",
    "http://phishing-site.com",
    "http://suspicious-offer.com"
]

# Insert URLs into Bloom Filter
for url in malicious_urls:
    bloom.add(url)

print("========== BLOOM FILTER ==========")
print("Application: Spam URL Detection")
print("\nKnown malicious URLs inserted successfully!")

# Test URLs
test_urls = [
    "http://fakebank-login.com",
    "http://google.com",
    "http://free-prize-win.com",
    "http://amazon.com",
    "http://safe-website.com",
    "http://malware-download.com"
]

print("\n========== URL CHECKING RESULTS ==========")

for url in test_urls:

    if bloom.check(url):
        print(url, "-> Possibly Malicious URL (Might be Present)")
    else:
        print(url, "-> Safe from Stored List (Definitely Not Present)")
